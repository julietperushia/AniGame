  m_Script: {fileID: 11500000, guid: 88aa7665c2fc4f546ae22b52e5d8156d, type: 3}
  m_Name: Mimic
  m_EditorClassIdentifier: Assembly-CSharp::Mimic
  talentName: Mimic
  autoDescription: 1
  description: 'Copy one enemy talent per cast. First choice: Nothingness, if any
    enemy has it (a trap that costs you HP). Next: an active talent of the strongest
    enemy card, which you cast yourself at once. Otherwise: a passive talent of the
    strongest enemy card, which you keep for the rest of the battle. Once Mimic has
    learned a passive, every later cast heals you 10% (Max 12%) of your max HP instead.
    Mana cost: 100.'
  manaCost: 100
  healPercent: 0.1
